# Agent Account Lab - Environment Variables Template
# Copy this file to .env and insert your API credentials.
# Note: Your real .env file is protected by .gitignore and will never be committed.

# OpenAI-Compatible API Key (e.g. from APInex, OpenAI, OpenRouter, Groq, Ollama)
APINEX_API_KEY=your_api_key_here

# OpenAI-Compatible Base URL (defaults to https://api.apinex.bond/v1)
APINEX_BASE_URL=https://api.apinex.bond/v1

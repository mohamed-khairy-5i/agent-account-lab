{
  "name": "agent-account-lab",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Synthetic multi-account testing & empirical benchmark for AI agents: detect wrong-account tool calls even when all accounts are authorized.",
  "author": "Eng. Mohamed Khairy",
  "license": "MIT",
  "homepage": "https://github.com/mohamed-khairy-5i/agent-account-lab#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohamed-khairy-5i/agent-account-lab.git"
  },
  "bugs": {
    "url": "https://github.com/mohamed-khairy-5i/agent-account-lab/issues"
  },
  "keywords": [
    "ai-agents",
    "agent-evaluation",
    "llm-benchmark",
    "ai-safety",
    "tool-calling",
    "function-calling",
    "multi-account",
    "context-pollution",
    "model-context-protocol",
    "mcp",
    "disambiguation",
    "glm-5",
    "deepseek",
    "qwen",
    "kimi",
    "gemini"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "install:all": "npm install && npm --prefix ui install",
    "ui:install": "npm --prefix ui install",
    "test": "node --import tsx --test tests/core.test.ts tests/adapter.test.ts",
    "test:core": "node --import tsx --test tests/core.test.ts",
    "test:adapter": "node --import tsx --test tests/adapter.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "node --import tsx scripts/validate.ts",
    "demo": "node --import tsx scripts/demo.ts",
    "check-all": "node --import tsx scripts/validate.ts && tsc --noEmit && node --import tsx --test tests/core.test.ts tests/adapter.test.ts",
    "benchmark:live": "node --import tsx scripts/benchmark-live.ts",
    "benchmark:models": "node --import tsx scripts/multi-model-benchmark.ts",
    "manifest:update": "node --import tsx scripts/update-manifest.ts",
    "manifest:verify": "node --import tsx scripts/verify-manifest.ts",
    "ui": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "ui:preview": "npm --prefix ui run preview"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2"
  }
}

{
  "name": "agent-account-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Synthetic multi-account testing for AI agents: detect wrong-account tool calls even when both accounts are authorized.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test tests/core.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.ts",
    "demo": "node scripts/demo.ts",
    "check-all": "node scripts/validate.ts && tsc --noEmit && node --test tests/core.test.ts",
    "benchmark:live": "node scripts/benchmark-live.ts",
    "benchmark:models": "node scripts/multi-model-benchmark.ts",
    "ui": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "ui:preview": "npm --prefix ui run preview"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
